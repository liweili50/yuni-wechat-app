<view class="home-container">
  <view class="home-navbar">
    <t-navbar>
      <view slot="left">
        <view class="home-navbar__left" bindtap="searchTurn">
          <t-search shape="round" placeholder="请搜索你想要的内容" disabled />
        </view>
      </view>
    </t-navbar>
  </view>

  <view class="home-content">
    <view wx:if="{{searchKeyword}}" class="home-search-bar">
      <text class="home-search-bar__label">搜索结果：{{searchKeyword}}</text>
      <text class="home-search-bar__clear" bindtap="clearSearch">清除</text>
    </view>
    <t-tabs sticky="{{true}}" defaultValue="recommend">
      <t-tab-panel label="推荐" value="recommend">
        <scroll-view class="home-scroll" style="{{homeScrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
          <t-pull-down-refresh value="{{enable}}" bind:refresh="onRefresh"
            loadingTexts="{{['下拉刷新', '松手刷新', '正在刷新', '刷新完成']}}">
            <view class="home-card-list">
              <view class="home-card-list__item">
                <t-swiper list="{{swiperList}}" navigation="{{ { type: 'dots-bar' } }}" height="488rpx" />
              </view>
              <view class="home-card-list__item" wx:for="{{cardInfo}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
                <card desc="{{item.desc}}" url="{{item.url}}" tags="{{item.tags}}" />
              </view>
            </view>
          </t-pull-down-refresh>
        </scroll-view>
      </t-tab-panel>
      <t-tab-panel label="我的关注" value="follow">
        <scroll-view class="home-scroll" style="{{homeScrollStyle}}" scroll-y enhanced show-scrollbar="{{false}}">
          <view class="home-card-list">
            <view class="home-card-list__item" wx:for="{{focusCardInfo}}" wx:key="id" data-id="{{item.id}}" bindtap="onCardTap">
              <card desc="{{item.desc}}" url="{{item.url}}" tags="{{item.tags}}" />
            </view>
          </view>
        </scroll-view>
      </t-tab-panel>
    </t-tabs>
  </view>
</view>
